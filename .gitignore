nimcache/
bin/
*.exe
.docker-home/
testresults/
.crisol/
tests/fixtures/bin/
tests/fixtures/nimcache/
# milpa: manifest (milpa.kdl) + lock (milpa.lock) are committed; the vendored
# deps (symlinks into ~/.cache/milpa) and the generated nim.cfg are not.
_deps/
nim.cfg
# Built CLI binary (nimble `bin = @["crisol"]` → ./crisol at repo root).
/crisol
# Stray compiled binaries from `nim c src/crisol/<mod>.nim` typecheck runs.
# Only .nim sources are tracked under src/; ignore any extensionless artifact.
/src/crisol/*
!/src/crisol/*.nim
!/src/crisol/*/
# Stray state-dir artifacts when crisol/tests run with stateDir defaulting to
# cwd (the normal location is .crisol/, already ignored above).
/cache/
/bin/
/depgraph
# Compiled test binaries from `nim r` runs (extensionless, sit next to the
# tracked *.nim sources).  Only .nim sources / subdirs are tracked.
/tests/integration/*
!/tests/integration/*.nim
!/tests/integration/*/
/tests/unit/*
!/tests/unit/*.nim
!/tests/unit/*/
# Scratch tmp dir some fixtures write into.
tests/fixtures/tmp/
